<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/smoke#" xml:base="http://example.org/smoke"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/smoke"/>
    <owl:Class rdf:about="http://example.org/smoke#Animal">
        <rdfs:label>animal</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/smoke#Dog">
        <rdfs:label>dog</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/smoke#Animal"/>
    </owl:Class>
</rdf:RDF>
